#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESCAPE        &kp Q  &kp W         &kp E     &kp R                    &kp T              &kp Y      &kp U          &kp I  &kp O           &kp P           &kp DELETE
&kp TAB           &kp A  &kp S         &kp D     &kp F                    &kp G              &kp H      &kp J          &kp K  &kp L           &kp MINUS       &kp ENTER
&kp LSHFT         &kp Z  &kp X         &kp C     &kp V                    &kp B              &kp SPACE  &kp ENTER      &kp N  &kp M           &kp COMMA       &kp DOT          &kp UP_ARROW  &kp SLASH
&kp LEFT_CONTROL  &mo 2  &kp LEFT_WIN  &kp LALT  &kp LANG_ZENKAKUHANKAKU  &kp LANG_HIRAGANA  &mo 1      &kp BACKSPACE  &mo 3  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp K_BACK  &trans     &kp K_FORWARD  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK   &mkp MCLK  &mkp RCLK      &kp LC(C)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans     &trans         &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans     &trans         &trans     &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans           &trans        &trans    &trans      &trans       &kp N7        &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans                &trans                 &kp AT_SIGN
&trans  &trans           &trans        &trans    &trans      &trans       &kp NUMBER_4  &kp N5           &kp NUMBER_6     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp EXCLAMATION  &kp QUESTION  &kp HASH  &kp DOLLAR  &kp PERCENT  &trans        &trans           &kp NUMBER_1     &kp NUMBER_2          &kp NUMBER_3           &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SLASH
&trans  &trans           &trans        &trans    &trans      &trans       &trans        &kp KP_NUMBER_0  &trans           &trans                &trans                 &trans
            >;
        };

        layer_3 {
            bindings = <
&trans        &kp F1        &kp F2        &kp F3        &kp F4        &kp F5      &trans          &kp FSLH  &kp ASTRK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&trans        &kp F6        &kp F7        &kp F8        &kp F9        &kp F10     &kp HOME        &trans    &kp MINUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&trans        &kp F11       &kp F12       &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &bt BT_CLR_ALL  &trans    &kp END    &trans           &kp GRAVE        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans          &trans    &trans     &kp KP_NUMBER_0  &kp DOT          &kp EQUAL
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
